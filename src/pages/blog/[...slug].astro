---
import { render } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import PostArt from '../../components/PostArt.astro';
import { getPosts, postYear } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
---

<Base title={post.data.title} description={post.data.description}>
  <a class="back meta" href="/blog/"><ArrowLeft size={16} aria-hidden="true" />All posts</a>
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <PostArt id={post.id} />
      <div class="byline">
        <a class="date meta" href={`/blog/${postYear(post)}/`} title={`All posts from ${postYear(post)}`}>
          <time datetime={post.data.date.toISOString()}>{date}</time>
        </a>
        <Tags tags={post.data.tags} />
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover { color: var(--ink); }
  .post-header { margin-bottom: 2.5rem; }
  .date { text-decoration: none; }
  .date:hover { color: var(--ink); }
  .byline {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
  }
  .post-header h1 {
    font-size: 2.3rem;
    font-weight: 500;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  @media (max-width: 600px) {
    .post-header { margin-bottom: 1.75rem; }
    .post-header h1 { font-size: 1.85rem; }
  }
</style>
