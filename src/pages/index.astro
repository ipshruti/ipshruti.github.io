---
import Base from '../layouts/Base.astro';
import PaintedLandscape from '../components/PaintedLandscape.astro';
import SiteLinks from '../components/SiteLinks.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<Base full>
  <div class="page">
    <div class="toggle"><ThemeToggle /></div>
    <main class="intro">
      <h1>Shruti Priya</h1>
      <ul class="site-links links"><SiteLinks /></ul>
    </main>
    <div class="art"><PaintedLandscape /></div>
  </div>
</Base>

<style>
  .page {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
  }
  .toggle {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 2;
  }

  .intro {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    text-align: center;
    padding: 0 1rem;
  }
  h1 {
    margin: 0;
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(2.6rem, 7vw, 4.8rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .links {
    margin-top: 1.4rem;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2rem;
  }
  @media (max-width: 480px) { .links { gap: 0.5rem 1.1rem; } }

  /* Landscape along the bottom, fading up into the paper below the name. */
  .art {
    position: absolute;
    inset: auto 0 0;
    height: 55vh;
    min-height: 16rem;
    -webkit-mask-image: linear-gradient(transparent 5%, #000 40%);
    mask-image: linear-gradient(transparent 5%, #000 40%);
  }
  .art :global(canvas) { position: absolute; inset: 0; }
</style>
