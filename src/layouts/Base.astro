---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import ThemeToggle from '../components/ThemeToggle.astro';
import SiteLinks from '../components/SiteLinks.astro';
import PaintedLandscape from '../components/PaintedLandscape.astro';

interface Props {
  title?: string;
  description?: string;
  bare?: boolean;
  /** Page draws its own full-width layout: no header, footer or column. */
  full?: boolean;
}

const { title, description = SITE_DESCRIPTION, bare = false, full = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    {full ? <slot /> : (
    <div class="wrap">
      <header class:list={['site-header', { bare }]}>
        {!bare && <a class="name" href="/">Shruti Priya</a>}
        <nav>
          {!bare && <ul class="site-links"><SiteLinks /></ul>}
          <ThemeToggle />
        </nav>
      </header>

      <main>
        <slot />
      </main>

      {!bare && (
      <footer class="site-footer meta">
        <span>All content copyright © Shruti Priya unless otherwise noted.</span>
        <a href="/rss.xml">rss</a>
      </footer>
      )}
      {!bare && <div class="footer-art"><PaintedLandscape /></div>}
    </div>
    )}
  </body>
</html>
