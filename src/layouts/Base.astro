---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_PROFILES } from '../consts';
import ThemeToggle from '../components/ThemeToggle.astro';
import SiteLinks from '../components/SiteLinks.astro';
import PaintedLandscape from '../components/PaintedLandscape.astro';

interface Props {
  title?: string;
  description?: string;
  bare?: boolean;
  /** Page draws its own full-width layout: no header, footer or column. */
  full?: boolean;
  /** Share image path (1200x630); defaults to the site card. */
  image?: string;
  /** Set on blog posts: marks the page as an article for previews and search. */
  article?: { published: Date; tags: string[] };
}

const SITE_CARD = '/og/default.jpg';
const { title, description = SITE_DESCRIPTION, bare = false, full = false, image = SITE_CARD, article } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const path = Astro.url.pathname;
const url = new URL(path, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const imageAlt = image === SITE_CARD ? `${SITE_TITLE}, over a painted sunset landscape` : `${title}, by ${SITE_TITLE}`;

const author = { '@type': 'Person', name: SITE_TITLE, url: Astro.site!.href, sameAs: SITE_PROFILES };
const structured = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: article.published.toISOString(),
      keywords: article.tags.join(', '),
      image: imageUrl,
      url,
      mainEntityOfPage: url,
      author,
    }
  : { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_TITLE, description: SITE_DESCRIPTION, url: Astro.site!.href, author };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_TITLE} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161514" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={url} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article && <meta property="article:author" content={Astro.site!.href} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    {full ? <slot /> : (
    <div class="wrap">
      <header class:list={['site-header', { bare }]}>
        {!bare && <a class="name" href="/">Shruti Priya</a>}
        <nav>
          {!bare && <ul class="site-links"><SiteLinks /></ul>}
          <ThemeToggle />
        </nav>
      </header>

      <main>
        <slot />
      </main>

      {!bare && (
      <footer class="site-footer meta">
        <span>All content copyright © Shruti Priya unless otherwise noted.</span>
        <a href="/rss.xml">rss</a>
      </footer>
      )}
      {!bare && <div class="footer-art"><PaintedLandscape /></div>}
    </div>
    )}
  </body>
</html>
